{
  "name": "visor-flow",
  "version": "0.2.0",
  "description": "A desktop voice-to-text app with Gemini-powered text refinement.",
  "main": "electron/main.cjs",
  "author": "Visor Flow contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "setup-gemini": "electron .",
    "start:app": "electron .",
    "dist": "electron-builder",
    "install-app": "electron-builder",
    "test": "node --check scripts/launch.cjs && node --check electron/main.cjs && node --check electron/preload.cjs && node --check src/renderer.js"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "build": {
    "appId": "com.visorflow.desktop",
    "productName": "Visor Flow",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "scripts/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Visor-Flow-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.8.2"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": false
  }
}
